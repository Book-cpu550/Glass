{
  "name": "glass",
  "productName": "Glass",
  "version": "4.2.1",
  "description": "A local math and science notebook with editable equations, chemistry, graphs and PDF export",
  "main": "main.cjs",
  "author": "Local",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "package": "electron-packager . Glass --platform=win32 --arch=x64 --out=release --overwrite --ignore=release --ignore=test --ignore=package-lock.json",
    "build": "node build-mathlive.cjs && esbuild rich-editor.source.js --bundle --format=iife --outfile=rich-editor.js",
    "prepackage": "npm run build",
    "postpackage": "node finalize-package.cjs",
    "install:local": "node install-local.cjs"
  },
  "dependencies": {
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-text-align": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "dompurify": "^3.3.0",
    "katex": "^0.19.1",
    "marked": "^17.0.0",
    "mathlive": "^0.111.4",
    "openchemlib": "file:vendor/openchemlib.tgz",
    "plotly.js-dist-min": "file:vendor/plotly.tgz"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.4.1",
    "esbuild": "^0.28.2",
    "playwright": "^1.65.1"
  }
}
