{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glass-private-sharing",
  "main": "worker.js",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "GLASS_RELAY", "class_name": "GlassRelay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GlassRelay"] }]
}
